{
    "redirects": [
        {
            "source": "/projects/beehive",
            "destination": "/projects/beehive/",
            "permanent": false
        },
        {
            "source": "/NHLMock",
            "destination": "https://hockeylotto.com",
            "permanent": true
        },
        {
            "source": "/NHLMock/:path*",
            "destination": "https://hockeylotto.com",
            "permanent": true
        },
        {
            "source": "/nhlmock",
            "destination": "https://hockeylotto.com",
            "permanent": true
        },
        {
            "source": "/nhlmock/:path*",
            "destination": "https://hockeylotto.com",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/projects/beehive/",
            "destination": "https://beehive-frontend-pi.vercel.app/"
        },
        {
            "source": "/projects/beehive/:path*",
            "destination": "https://beehive-frontend-pi.vercel.app/:path*"
        },
        {
            "source": "/projects",
            "destination": "/projects/index.html"
        },
        {
            "source": "/poetry",
            "destination": "/poetry/index.html"
        },
        {
            "source": "/projects/:slug",
            "destination": "/projects/:slug/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
